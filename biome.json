{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "src/**",
      "e2e/**",
      "package.json",
      "tsconfig.json",
      "biome.json",
      ".dependency-cruiser.cjs",
      "tsup.config.ts",
      "vitest.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
